# Copia este fichero como news/.env (no se sube a git) y protégelo: chmod 600 news/.env
# Claves de los modelos (llm.py). Sin una, sus modelos se saltan y se usa el siguiente de la lista
# Model Access Key de la inferencia serverless de DigitalOcean (solo da acceso a los modelos): el principal
DO_MODEL_ACCESS_KEY=
# Groq (gpt-oss-120b, qwen3.8-27b y gpt-oss-20b, nivel gratuito): respaldo de las noticias y la agenda
GROQ_API_KEY=
# Gemini (nivel gratuito): principal de los duplicados y respaldo de todo lo demás
GEMINI_API_KEY=
# Anthropic (opcional, de pago; hace falta pip install anthropic): para los modelos "anthropic:", como
# anthropic:claude-haiku-5-5 (con @low, @medium o @high, el esfuerzo de razonamiento)
ANTHROPIC_API_KEY=
# Opcional: modelos por orden de preferencia; sin prefijo, DigitalOcean; "groq:", "gemini:" y "anthropic:", sus APIs
# NEWS_MODELS=glm-5.3-flash,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash,gemini:gemini-flash-latest
# DEDUPE_MODELS=gemini:gemini-3.5-flash,glm-5.3-flash,groq:openai/gpt-oss-120b,gemini:gemini-flash-latest
# ANALYSIS_MODELS=glm-5.3-flash,glm-5.3-flash@high,gemini:gemini-3.5-flash,gemini:gemini-flash-latest
# Análisis en sombra (solo se registra, para comparar su acierto con eval_analysis.py --shadow); vacío, no se hace
# ANALYSIS_SHADOW_MODELS=glm-5.3-flash@high
# ANALYSIS_TEXT_MODELS=glm-5.3-flash@high,glm-5.3-flash@medium,gemini:gemini-3.5-flash,gemini:gemini-flash-latest
# (tras una @, el esfuerzo de razonamiento: medium o high; sin @, el del modelo, que en GLM es el máximo)
# Opcional: por defecto news/out (lo que sirve la web en /news/) y news/state (titulares ya clasificados)
# NEWS_OUT_DIR=
# NEWS_STATE_DIR=
