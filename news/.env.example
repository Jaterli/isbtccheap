# Copia este fichero como news/.env (no se sube a git) y protégelo: chmod 600 news/.env
# Model Access Key de la inferencia serverless de DigitalOcean (solo da acceso a los modelos)
DO_MODEL_ACCESS_KEY=
# Análisis de BTC (build_analysis.py): "digitalocean" (por defecto, usa la clave de arriba) o "gemini" (nivel de pago)
# ANALYSIS_PROVIDER=digitalocean
# Opcional: modelos que se prueban en orden si el anterior falla
# ANALYSIS_MODELS=glm-5.3-flash,qwen3.5-397b-a17b,deepseek-4-flash
# Solo con ANALYSIS_PROVIDER=gemini: clave de la API de Gemini (Google AI Studio)
# GEMINI_API_KEY=
# Opcional: por defecto news/out (lo que sirve la web en /news/) y news/state (titulares ya clasificados)
# NEWS_OUT_DIR=
# NEWS_STATE_DIR=
