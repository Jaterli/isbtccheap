# Copia este fichero como news/.env (no se sube a git) y protégelo: chmod 600 news/.env
# Model Access Key de la inferencia serverless de DigitalOcean (solo da acceso a los modelos)
DO_MODEL_ACCESS_KEY=
# Clave de la API de Gemini (Google AI Studio) para el análisis de BTC (build_analysis.py)
GEMINI_API_KEY=
# Opcional: modelos de Gemini que se prueban en orden si el anterior está saturado
# ANALYSIS_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest
# Opcional: por defecto news/out (lo que sirve la web en /news/) y news/state (titulares ya clasificados)
# NEWS_OUT_DIR=
# NEWS_STATE_DIR=
