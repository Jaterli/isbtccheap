# Copia este fichero como news/.env (no se sube a git) y protégelo: chmod 600 news/.env
# Model Access Key de la inferencia serverless de DigitalOcean (solo da acceso a los modelos)
DO_MODEL_ACCESS_KEY=
# Análisis de BTC (build_analysis.py). Opcional: modelos que se prueban en orden si el anterior falla; los "gemini:" van a
# la API de Gemini (nivel gratuito) y necesitan GEMINI_API_KEY
# ANALYSIS_MODELS=glm-5.3-flash,qwen3.5-397b-a17b,gemini:gemini-3.5-flash,gemini:gemini-flash-latest
GEMINI_API_KEY=
# Opcional: por defecto news/out (lo que sirve la web en /news/) y news/state (titulares ya clasificados)
# NEWS_OUT_DIR=
# NEWS_STATE_DIR=
