# Copia este fichero como news/.env (no se sube a git) y protégelo: chmod 600 news/.env
# Claves de los modelos (llm.py). Sin una, sus modelos se saltan y se usa el siguiente de la lista
# Model Access Key de la inferencia serverless de DigitalOcean (solo da acceso a los modelos): el principal
DO_MODEL_ACCESS_KEY=
# Groq (gpt-oss-120b, nivel gratuito): respaldo de las noticias y la agenda
GROQ_API_KEY=
# Gemini (nivel gratuito): respaldo de todo
GEMINI_API_KEY=
# Opcional: modelos por orden de preferencia; sin prefijo, DigitalOcean; "groq:" y "gemini:", sus APIs
# NEWS_MODELS=glm-5.3-flash,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,gemini:gemini-flash-latest
# ANALYSIS_MODELS=glm-5.3-flash,qwen3.5-397b-a17b,gemini:gemini-3.5-flash,gemini:gemini-flash-latest
# Opcional: por defecto news/out (lo que sirve la web en /news/) y news/state (titulares ya clasificados)
# NEWS_OUT_DIR=
# NEWS_STATE_DIR=
