# Los JSON del pipeline se leen directamente del repositorio, también en desarrollo: el commit diario de la
# GitHub Action llega a la web en unos minutos (caché de GitHub: 5 min) sin redesplegar ni sincronizar nada.
# Para ver los generados en local con pipeline/build.py, crea web/.env.local con: VITE_DATA_URL=/data
VITE_DATA_URL=https://raw.githubusercontent.com/Jaterli/isbtccheap/main/web/public/data
