# En producción los JSON del pipeline se leen directamente del repositorio: el commit diario de la GitHub Action
# llega a la web en unos minutos (caché de GitHub: 5 min) sin redesplegar ni sincronizar el servidor.
# En desarrollo (npm run dev) se usan los de web/public/data, generados en local con pipeline/build.py
VITE_DATA_URL=https://raw.githubusercontent.com/Jaterli/isbtccheap/main/web/public/data
